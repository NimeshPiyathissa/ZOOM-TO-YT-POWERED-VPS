# Stream settings file - reference copy.
#
# The installer creates the real file at /home/zoombot/zoom-stream/.env (owner zoombot, mode 600) from your answers.
# You normally never edit it by hand: the dashboard changes these values (Output page, Live Studio, Settings) and
# restarts only what a change needs. If you do edit it, keep it private and restart the affected service.
#
# Format: KEY=value, one per line. Values with spaces or special characters go in double quotes. The file is parsed,
# never executed (scripts/lib.sh load_env_file), so shell syntax such as $(...) is NOT evaluated.
# Never commit a real .env - it holds your YouTube stream key.

# ------------------------------------------------------------------ YouTube

# Stream key from YouTube Studio > Go live > Stream. SECRET. Empty until you set it (dashboard: Live Studio).
YT_STREAM_KEY=

# Ingest server, without the key. Leave unset for YouTube's default secure ingest
# (rtmps://a.rtmps.youtube.com:443/live2). Must start with rtmp:// or rtmps://.
# YT_RTMP_URL=rtmps://a.rtmps.youtube.com:443/live2

# ------------------------------------------------------------------ Output quality (dashboard: Output page)

# Encoded video size, frame rate and bitrates. The installer writes the 720p or 1080p preset you chose:
#   720p : RESOLUTION=1280x720  FPS=30 VIDEO_BITRATE=3000 AUDIO_BITRATE=160 X264_PRESET=ultrafast
#   1080p: RESOLUTION=1920x1080 FPS=30 VIDEO_BITRATE=6000 AUDIO_BITRATE=192 X264_PRESET=superfast
RESOLUTION=1280x720
FPS=30
# Video bitrate in kbps (1000-8000).
VIDEO_BITRATE=3000
# Audio bitrate in kbps.
AUDIO_BITRATE=160
# x264 speed/quality trade-off: ultrafast uses the least CPU; slower presets look better but need more CPU.
X264_PRESET=ultrafast

# ------------------------------------------------------------------ Virtual screen

# X display the bot draws on. Do not change unless you know why.
DISPLAY_NUM=:99
# Virtual screen size when it must differ from RESOLUTION (advanced: Clean Broadcast native mode uses 1928x1225 so
# Zoom's video area is exactly 1920x1080). Empty = same as RESOLUTION.
# DISPLAY_SIZE=

# ------------------------------------------------------------------ Zoom

# Name the bot shows to other participants.
BOT_NAME="Stream Bot"
# guest = join without signing in; google = use the Google account signed in on the Remote GUI.
ZOOM_SIGNIN_MODE=guest
# The meeting link and passcode are normally managed on the dashboard's Zoom page (saved sources), which writes
# them here for the active meeting. SECRET.
# ZOOM_LINK=
# ZOOM_PASSCODE=

# ------------------------------------------------------------------ Optional: Telegram notifications

# Bot token from @BotFather and the chat to notify (dashboard: Settings). The token is SECRET.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------ Dashboard process environment (not this file)
#
# These go in a systemd drop-in for dashboard.service, not in this file:
#   sudo systemctl edit dashboard     then add:
#   [Service]
#   Environment=SCHEDULE_TIMEZONE=Europe/London
# SCHEDULE_TIMEZONE  timezone for the Schedule page if it should differ from the server timezone.
