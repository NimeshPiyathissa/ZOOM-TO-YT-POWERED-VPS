# Text files use LF everywhere: a CRLF shell script fails on Linux ("bad interpreter").
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.example text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.ttf binary
*.otf binary
